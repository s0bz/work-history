<title>Nikita Sobolev — Experience</title>
<style>
    :root{
      --bg:#f7f9fb;--white:#fff;--ink:#101418;--muted:#626b75;--blue:#246fae;--blue-dark:#1d5e94;
      --navy:#142b40;--navy-2:#0f2233;--line:rgba(20,45,70,.12);--soft-blue:#eef5fa;
      --shadow:0 18px 50px rgba(20,40,60,.09);--radius:8px;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;background:var(--bg);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Inter,Arial,sans-serif;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
    a{color:inherit;text-decoration:none}
    .container{width:min(100%,1480px);margin:0 auto;padding-inline:clamp(24px,5vw,72px)}
    .site-header{position:sticky;top:0;z-index:50;height:78px;border-bottom:1px solid var(--line);background:rgba(247,249,251,.97);backdrop-filter:blur(10px)}
    .header-inner{height:100%;display:flex;align-items:center;justify-content:space-between;gap:28px}
    .brand{font-size:15px;font-weight:800;letter-spacing:.075em;white-space:nowrap}
    .nav-links{display:flex;align-items:center;gap:24px}
    .nav-link{position:relative;padding:7px 0;color:#313840;font-size:12px;font-weight:720;letter-spacing:.06em;text-transform:uppercase}
    .nav-link::after{content:"";position:absolute;left:0;bottom:1px;width:0;height:1px;background:var(--blue);transition:width .18s ease}.nav-link:hover{color:var(--blue)}.nav-link:hover::after{width:100%}
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:44px;padding:11px 17px;border:1px solid transparent;border-radius:7px;font-size:12px;font-weight:780;letter-spacing:.045em;text-transform:uppercase;transition:transform .18s ease,box-shadow .18s ease,background-color .18s ease,border-color .18s ease,color .18s ease}
    .btn-primary{background:var(--blue);color:#fff;box-shadow:0 4px 14px rgba(36,111,174,.13)}.btn-primary:hover{background:var(--blue-dark);transform:translateY(-2px);box-shadow:0 8px 20px rgba(36,111,174,.18)}
    .btn-secondary{background:#fff;border-color:rgba(20,45,70,.18);color:#222930}.btn-secondary:hover{background:var(--soft-blue);border-color:rgba(36,111,174,.42);transform:translateY(-2px);box-shadow:0 7px 17px rgba(20,40,60,.07)}
    .hero{padding-block:clamp(76px,9vw,132px) clamp(58px,7vw,100px);background:radial-gradient(circle at 82% 42%,rgba(36,111,174,.052),transparent 37%)}
    .eyebrow,.section-label{margin:0 0 22px;color:var(--blue);font-size:12px;font-weight:780;letter-spacing:.115em;line-height:1.45;text-transform:uppercase}.label-line::after{content:"";display:inline-block;width:62px;height:1px;margin-left:14px;vertical-align:middle;background:rgba(36,111,174,.45)}
    h1{position:relative;max-width:900px;margin:0;font-size:clamp(52px,5.8vw,88px);line-height:.92;letter-spacing:-.06em;font-weight:800}h1::before{content:"";position:absolute;left:-19px;top:6%;width:2px;height:88%;border-radius:2px;background:var(--blue);opacity:.84}
    .hero-copy{max-width:780px;margin:28px 0 0;color:#4f5963;font-size:18px;line-height:1.65}.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}
    .section{padding-block:clamp(78px,8vw,116px)}.section-white{background:#fff}.section-head{max-width:820px;margin-bottom:38px}.section-title{margin:0;font-size:clamp(38px,4vw,60px);line-height:1.04;letter-spacing:-.05em}.section-deck{margin:18px 0 0;color:var(--muted);font-size:17px;line-height:1.65;max-width:760px}
    .timeline{position:relative;display:grid;gap:0}.timeline::before{content:"";position:absolute;left:148px;top:0;bottom:0;width:1px;background:rgba(36,111,174,.27)}
    .timeline-row{position:relative;display:grid;grid-template-columns:110px minmax(0,1fr);gap:58px;padding:34px 0;border-bottom:1px solid var(--line)}.timeline-row::before{content:"";position:absolute;left:143px;top:49px;width:13px;height:13px;border:2px solid var(--blue);border-radius:50%;background:var(--white)}
    .years{color:var(--blue);font-size:12px;font-weight:800;letter-spacing:.08em}.experience-main{display:grid;grid-template-columns:minmax(280px,.52fr) minmax(0,1fr);gap:clamp(30px,6vw,80px)}.experience-name{margin:0;font-size:clamp(24px,2.2vw,32px);line-height:1.12;letter-spacing:-.035em}.experience-role{margin:10px 0 0;color:#303741;font-size:15px;font-weight:740}.experience-copy{margin:0;color:var(--muted);font-size:16px;line-height:1.7}.experience-links{display:flex;flex-wrap:wrap;gap:10px;margin-top:16px}
