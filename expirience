    .footer{background:var(--navy-2);color:#fff}.footer-main{display:grid;grid-template-columns:1fr auto;gap:40px;padding-block:42px;border-top:1px solid rgba(255,255,255,.13)}.footer-brand{font-size:15px;font-weight:800;letter-spacing:.07em}.footer-location{margin:8px 0 0;color:#93a4b1;font-size:13px}.footer-links{display:flex;flex-wrap:wrap;gap:22px;align-items:start}.footer-link{color:#c5d0d8;font-size:11px;font-weight:750;letter-spacing:.07em;text-transform:uppercase}.footer-link:hover{color:#6eb7ea}.copyright{padding:16px 0 28px;border-top:1px solid rgba(255,255,255,.09);color:#718594;font-size:11px}

    .experience-heading{display:grid;grid-template-columns:48px minmax(0,1fr);gap:16px;align-items:center}
    .org-mark{width:48px;height:48px;border:1px solid var(--line);border-radius:8px;background:#fff;display:grid;place-items:center;overflow:hidden;flex:0 0 48px}
    .org-mark img{display:block;max-width:82%;max-height:82%;object-fit:contain}
    .org-mark-text{color:var(--blue);font-size:15px;font-weight:850;letter-spacing:.02em}

    .org-mark img[alt="HI4 logo"]{max-width:76%;max-height:76%}
    .org-mark img[alt="New Jersey 87’s logo"]{max-width:72%;max-height:72%}
    .org-mark img[alt="NEC Athletics logo"]{max-width:90%;max-height:72%}
    .org-mark img[alt="NEC Athletics mascot logo"]{max-width:86%;max-height:86%}
    .experience-tags{display:flex;flex-wrap:wrap;gap:7px 12px;margin-top:14px;color:#6b7580;font-size:11px;font-weight:800;letter-spacing:.075em;text-transform:uppercase}
    .experience-tags span+span::before{content:"·";margin-right:12px;color:rgba(36,111,174,.55)}
    .thread{background:#fff}.thread-panel{border-left:2px solid var(--blue);padding:28px 0 28px 28px;max-width:980px}.thread-kicker{margin:0 0 14px;color:var(--blue);font-size:12px;font-weight:800;letter-spacing:.115em;text-transform:uppercase}.thread-title{margin:0;font-size:clamp(34px,3.2vw,46px);line-height:1.05;letter-spacing:-.04em}.thread-copy{max-width:820px;margin:18px 0 0;color:var(--muted);font-size:17px;line-height:1.7}
    @media(max-width:860px){.site-header{height:68px}.nav-links{display:none}.timeline::before{left:6px}.timeline-row{grid-template-columns:1fr;gap:12px;padding:25px 0 25px 28px}.timeline-row::before{left:2px;top:31px}.experience-main{grid-template-columns:1fr;gap:10px}.cards{grid-template-columns:1fr}.footer-main{grid-template-columns:1fr}.footer-links{gap:16px 20px}}
    @media(max-width:620px){.experience-heading{grid-template-columns:42px minmax(0,1fr);gap:14px}.org-mark{width:42px;height:42px}.thread-panel{padding-left:18px}.experience-tags{font-size:10px;gap:6px 10px}.container{padding-inline:18px}.hero{padding-block:56px 76px}h1{font-size:clamp(42px,13vw,54px)}h1::before{left:-11px;width:1.5px}.hero-copy{font-size:16px;line-height:1.58}.actions{display:grid;grid-template-columns:1fr}.btn{width:100%}.section{padding-block:76px}.section-title{font-size:clamp(34px,10vw,42px)}.section-deck{font-size:16px}.footer-links{display:grid;grid-template-columns:repeat(2,1fr)}}
  </style>
